<script server>
// Everything arrives ready to print. `showRows` is built and escaped in
// app/Jobs/SendCityAlerts.ts, the same way the framework's order mail passes
// its line items. Nothing a visitor typed is printed: anyone can fill in the
// form with any address, so the mail only ever names real tour places.
const place = props.place || ''
const showRows = props.showRows || ''
const cityUrl = props.cityUrl || '#'
const unsubscribeUrl = props.unsubscribeUrl || '#'
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <title>Mario Adrion is coming to {{ place }}</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #0e0e0d; line-height: 1.6; color: #d9d6cd;">
  <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse;">
    <tr>
      <td style="padding: 40px 20px;">
        <table role="presentation" cellpadding="0" cellspacing="0" style="max-width: 560px; margin: 0 auto;">
          <tr>
            <td style="padding-bottom: 28px;">
              <p style="margin: 0; color: #f3f1ea; font-size: 22px; font-weight: 800; letter-spacing: -0.01em; text-transform: uppercase;">Mario Adrion</p>
            </td>
          </tr>
          <tr>
            <td style="background-color: #1a1a18; border-radius: 14px; padding: 36px 32px;">
              <p style="margin: 0 0 8px; color: #f5c542; font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;">The Superior Comedy Tour</p>
              <h1 style="margin: 0 0 16px; color: #f3f1ea; font-size: 28px; line-height: 1.15; font-weight: 800;">Mario is coming to {{ place }}.</h1>
              <p style="margin: 0 0 24px; color: #a8a49a; font-size: 16px;">Tickets are on sale now.</p>

              <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; border-top: 1px solid #2c2b27;">
                {!! showRows !!}
              </table>

              <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 28px 0 0;">
                <tr>
                  <td style="background-color: #f5c542; border-radius: 999px;">
                    <a href="{{ cityUrl }}" style="display: inline-block; padding: 12px 24px; color: #0e0e0d; font-size: 15px; font-weight: 700; text-decoration: none;">See every date in {{ place }}</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding: 24px 4px 0; color: #77746c; font-size: 13px;">
              You are getting this because you asked Mario to play near you on his website and left this address for ticket news.
              <a href="{{ unsubscribeUrl }}" style="color: #a8a49a;">Stop these emails</a>.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
