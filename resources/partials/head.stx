<script server>
// Imported here, not inherited from the including page's scope: a partial
// that leans on the page for shared constants renders them empty on every
// page that did not happen to import them itself.
import { indexable, siteOrigin, socialImage, socialImageAlt } from '../data/site'

// Owned by the including page, which is the one thing a partial should take
// from its scope. Declared so the template typechecks; `declare` emits no
// code, so the page's values are what render.
declare const pageTitle: string
declare const pageDescription: string
declare const canonicalPath: string
declare const jsonLd: string | undefined
</script>

{{-- Shared <head>. The page declares pageTitle, pageDescription and
  canonicalPath; jsonLd is optional. --}}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ siteOrigin }}{{ canonicalPath }}">
@if (indexable)
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
@else
  <meta name="robots" content="noindex, nofollow">
@endif

{{-- One theme. The brand is a black stage and every photograph is lit for
  it, so the site is dark and says so. --}}
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0e0e0d">

{{-- Generated by `buddy generate:images` from resources/icon.png, except the
  SVG, which is the source mark itself. --}}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">

<meta property="og:type" content="profile">
<meta property="og:site_name" content="Mario Adrion">
<meta property="og:locale" content="en_US">
<meta property="og:url" content="{{ siteOrigin }}{{ canonicalPath }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:image" content="{{ socialImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ socialImageAlt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@marioadrion">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ socialImage }}">
<meta name="twitter:image:alt" content="{{ socialImageAlt }}">

{{-- Both faces are served from this origin: no third-party request on the
  critical path, and nothing to disclose about visitors' IPs. Anybody's width
  axis gives the condensed poster caps from the same file as its body weights. --}}
<link rel="preload" href="/assets/fonts/anybody-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/styles/mario.css">

<link rel="alternate" type="text/calendar" title="Mario Adrion tour dates" href="/tour.ics">

@if (typeof jsonLd !== 'undefined' && jsonLd)
  <script type="application/ld+json">{!! jsonLd !!}</script>
@endif
